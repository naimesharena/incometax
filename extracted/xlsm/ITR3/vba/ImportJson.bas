               IncmNature_SPI = "Business/Profession"
            ElseIf IncmNature_SPI = "OS" Then
               IncmNature_SPI = "Other sources"
            ElseIf IncmNature_SPI = "EI" Then
               IncmNature_SPI = "Exempt Income"
            ElseIf IncmNature_SPI = "HP" Then
