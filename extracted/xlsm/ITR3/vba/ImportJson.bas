Function ImportSchedule80RA(ByVal jsonObject As Object)
On Error Resume Next
Dim jsonDictionary As Object
Dim Node, Nodelist, init As Object

Dim TotalXMLRow, rowcount, cnt, RecTCS  As Long
Dim TotalDiffRow As Long
Dim TotalExRow As Long
Dim DoneeNameColNo, AddrDtlColNo, CityColNo, StateColNo, PincodeColNo, DoneePANColNo, AmtCashColNo, AmtOtherColNo, EligibleAmtColNo, iState, sState

  
Set init = jsonObject("Schedule80RA")
If init.exists("DonationDtlsRsrchAssctn") Then
  
Set Nodelist = jsonObject("Schedule80RA")("DonationDtlsRsrchAssctn")
    
    DoneeNameColNo = Sheet50.Range("Name_of_Donee_80GGA").Column
    AddrDtlColNo = Sheet50.Range("Address_80GGA").Column
    CityColNo = Sheet50.Range("City_Town_District_80GGA").Column
    StateColNo = Sheet50.Range("State_Code_80GGA").Column
    PincodeColNo = Sheet50.Range("Pincode_80GGA").Column
    DoneePANColNo = Sheet50.Range("PAN_of_donee_80GGA").Column
    AmtCashColNo = Sheet50.Range("Donation_cash_80GGA").Column
    AmtOtherColNo = Sheet50.Range("Donation_other_80GGA").Column
    EligibleAmtColNo = Sheet50.Range("Donation_Eligible_80GGA").Column
    
    TotalExRow = Sheet50.Range("Name_of_Donee_80GGA").Rows.count
    
    TotalXMLRow = Nodelist.count
    TotalDiffRow = TotalXMLRow - TotalExRow
    
    If (TotalXMLRow > 0) Then
        If Sheet50.Range("Name_of_Donee_80GGA").Locked = False Then
            Sheet50.Range("Name_of_Donee_80GGA").ClearContents
        End If
        If Sheet50.Range("Address_80GGA").Locked = False Then
            Sheet50.Range("Address_80GGA").ClearContents
        End If
        If Sheet50.Range("City_Town_District_80GGA").Locked = False Then
            Sheet50.Range("City_Town_District_80GGA").ClearContents
        End If
        If Sheet50.Range("State_Code_80GGA").Locked = False Then
            Sheet50.Range("State_Code_80GGA").ClearContents
        End If
        If Sheet50.Range("Pincode_80GGA").Locked = False Then
            Sheet50.Range("Pincode_80GGA").ClearContents
        End If
        If Sheet50.Range("PAN_of_donee_80GGA").Locked = False Then
            Sheet50.Range("PAN_of_donee_80GGA").ClearContents
        End If
        If Sheet50.Range("Donation_cash_80GGA").Locked = False Then
            Sheet50.Range("Donation_cash_80GGA").ClearContents
        End If
        If Sheet50.Range("Donation_other_80GGA").Locked = False Then
            Sheet50.Range("Donation_other_80GGA").ClearContents
        End If
        If Sheet50.Range("Donation_Eligible_80GGA").Locked = False Then
            Sheet50.Range("Donation_Eligible_80GGA").ClearContents
        End If
    End If
    
    If (TotalDiffRow > 0) Then
     AddDiffRows_80RA (TotalDiffRow)
    End If
    
    rowcount = getRowNo(Sheet50.Range("Name_of_Donee_80GGA").name)
    rowcount = rowcount - 1
    cnt = 0
    
    For Each Node In Nodelist
        rowcount = rowcount + 1
       
            If Sheet50.Cells(rowcount, DoneeNameColNo).Locked = False Then
                Sheet50.Cells(rowcount, DoneeNameColNo).value = Node("NameOfDonee")
            End If
            If Sheet50.Cells(rowcount, AddrDtlColNo).Locked = False Then
                Sheet50.Cells(rowcount, AddrDtlColNo).value = Node("AddressDetail")("AddrDetail")
            End If
            If Sheet50.Cells(rowcount, CityColNo).Locked = False Then
                Sheet50.Cells(rowcount, CityColNo).value = Node("AddressDetail")("CityOrTownOrDistrict")
            End If
            iState = Node("AddressDetail")("StateCode")
            sState = Findtext(CStr(iState), "State")
            If Sheet50.Cells(rowcount, StateColNo).Locked = False Then
                Sheet50.Cells(rowcount, StateColNo).value = sState
            End If
            If Sheet50.Cells(rowcount, PincodeColNo).Locked = False Then
                Sheet50.Cells(rowcount, PincodeColNo).value = Node("AddressDetail")("PinCode")
            End If
            If Sheet50.Cells(rowcount, DoneePANColNo).Locked = False Then
                Sheet50.Cells(rowcount, DoneePANColNo).value = Node("DoneePAN")
            End If
            If Sheet50.Cells(rowcount, AmtCashColNo).Locked = False Then
                Sheet50.Cells(rowcount, AmtCashColNo).value = Node("DonationAmtCash")
            End If
            If Sheet50.Cells(rowcount, AmtOtherColNo).Locked = False Then
                Sheet50.Cells(rowcount, AmtOtherColNo).value = Node("DonationAmtOtherMode")
            End If
            If Sheet50.Cells(rowcount, EligibleAmtColNo).Locked = False Then
                Sheet50.Cells(rowcount, EligibleAmtColNo).value = Node("EligibleDonationAmt")
            End If
    cnt = cnt + 1
    Next Node
RecTCS = cnt
End If
End Function
