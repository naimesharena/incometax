    Dim mIntCells As Long
    Dim mIntCtr As Long
    Dim ccount As Long
    ccount = 0
    mIntCells = Range("EI.NatureOfIncome").count
    Set rangecells = Range("EI.NatureOfIncome").Cells
    Dim natureAmount As Variant
    For mIntCtr = 1 To mIntCells
            If Not (rangecells.item(mIntCtr).value = "" Or rangecells.item(mIntCtr).value = "(Select)") Then
                ccount = ccount + 1
            End If
    Next
    ColCount_OthersInc = ccount
    rngname_OthersInc = "EI.NatureOfIncome;EI.Description;EI.Amount;"
End Function
