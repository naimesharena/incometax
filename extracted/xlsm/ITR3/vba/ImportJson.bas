Set Nodelist = jsonObject("ITR3ScheduleBP")("SpecifiedBusinessInc")("DedUs35ADSubSec5Dtls")

    EI_DrpdnColNo = Sheet9.Range("EI.Drpdn").Column


    TotalExRow = Range("EI.Drpdn").Rows.count
    
    TotalXMLRow = Nodelist.count
    TotalDiffRow = TotalXMLRow - TotalExRow
    
    
    If (TotalXMLRow > 0) Then
        If Sheet9.Range("EI.Drpdn").Locked = False Then
            Sheet9.Range("EI.Drpdn").ClearContents
        End If
    End If
    
    If (TotalDiffRow > 0) Then
     AddDiffRows_SpecifiedBusiness (TotalDiffRow)
    End If
    
    rowcount = Sheet9.Range("EI.Drpdn").row
    
    rowcount = rowcount - 1
    cnt = 0
    
    For Each Node In Nodelist
        rowcount = rowcount + 1
        iDrpDwn = Node("DedUs35ADSubSec5")
'        sDrpDwn = Findtext(CStr(iDrpDwn), "BP_Drp")

        If iDrpDwn = "a" Then
            sDrpDwn = "(a) laying and operating a cross-country natural gas pipeline network for distribution, including storage facilities being an integral part of such network;"
        ElseIf iDrpDwn = "aa" Then
            sDrpDwn = "(aa) building and operating a new hotel of two-star or above category as classified by the Central Government"
        ElseIf iDrpDwn = "ab" Then
            sDrpDwn = "(ab) building and operating a new hospital with at least one hundred beds for patients"
        ElseIf iDrpDwn = "ac" Then
            sDrpDwn = "(ac) developing and building a housing project under a scheme for slum redevelopment or rehabilitation framed by the Central Government or a State Government, as the case may be, and which is notified by the Board in this behalf in accordance with the guidelines as may be prescribed"
        ElseIf iDrpDwn = "ad" Then
            sDrpDwn = "(ad) developing and building a housing project under a scheme for affordable housing framed by the Central Government or a State Government, as the case may be, and notified by the Board in this behalf in accordance with the guidelines as may be prescribed"
         ElseIf iDrpDwn = "ae" Then
            sDrpDwn = "(ae) new plant or in a newly installed capacity in an existing plant for production of fertilizer"
        ElseIf iDrpDwn = "af" Then
            sDrpDwn = "(af) setting up and operating an inland container depot or a container freight station notified or approved under the Customs Act, 1962 (52 of 1962)"
        ElseIf iDrpDwn = "ag" Then
            sDrpDwn = "(ag) bee-keeping and production of honey and beeswax"
        ElseIf iDrpDwn = "ah" Then
            sDrpDwn = "(ah) setting up and operating a warehousing facility for storage of sugar"
        ElseIf iDrpDwn = "ai" Then
            sDrpDwn = "(ai) laying and operating a slurry pipeline for the transportation of iron ore"
        ElseIf iDrpDwn = "aj" Then
            sDrpDwn = "(aj) setting up and operating a semi-conductor wafer fabrication manufacturing unit, and which is notified by the Board in accordance with such guidelines as may be prescribed"
        ElseIf iDrpDwn = "ak" Then
            sDrpDwn = "(ak) developing or operating and maintaining or developing, operating and maintaining, any infrastructure facility; and"
        ElseIf iDrpDwn = "b" Then
            sDrpDwn = "(b)  all other cases not falling under any of the above clauses."
        Else
            sDrpDwn = "(Select)"
        End If
        If Sheet9.Cells(rowcount, EI_DrpdnColNo).Locked = False Then
            Sheet9.Cells(rowcount, EI_DrpdnColNo).value = sDrpDwn
        End If
    
    cnt = cnt + 1
    Next Node
RecSpecifiedBusiness = cnt
End If

