Sub AddLTCGCostImpRows(Optional ByVal bn As Long = 0)
On Error GoTo endline
    
    Dim vRows  As Long
    Dim blocknum As Variant
    Dim blockvalue As Variant
    Dim newrngname As Variant
    Dim numberofrows As Long
    Dim newfrmsize, i, te  As Long

    Application.EnableEvents = False
    Sheets("CG").Activate

    
    Sheet13.Unprotect Password:=getmsgstate
        If bn = 0 Then
        blocknum = ActiveSheet.Buttons(Application.Caller).TopLeftCell.name
        blockvalue = Range(blocknum).Offset(0, -2).value
        Else
        blockvalue = bn
        End If
                
        DefinedgridNameRange = "LTCG.Bbia_ImproveCost" & blockvalue & ";LTCG.Bbib_ImproveCostYear" & blockvalue & ";LTCG.Bbii_ImproveCost" & blockvalue & ";LTCG.Bbib_ImproveCostYear_Vlookup" & blockvalue & ";"
        ActiveCellRange = searchLastRow("LTCG.Bbia_ImproveCost" & blockvalue)
        vRows = InsertRowsAndFillFormulasOneRow
        Call ExendRangeNameToTable(vRows, DefinedgridNameRange)
    
    Sheet13.Unprotect Password:=getmsgstate
    Application.EnableEvents = False

        newfrmsize = Sheet13.Range("NumRowsPropertyBlock_LTCG").value
        newfrmsize = newfrmsize + numberofrows
        Sheet13.Range("NumRowsPropertyBlock_LTCG").value = newfrmsize

endline:

   Sheet13.Protect Password:=getmsgstate
   Application.EnableEvents = True
End Sub
Function InsertRowsAndFillFormulasOneRow(Optional vRows As Long = 0) As Long
    
    Dim x As Long
    Dim sht As Worksheet
    Dim shts() As String
    Dim i As Long
    ActiveCell.EntireRow.Select  'So you do not have to preselect entire row
    
    If vRows = 0 Then
        vRows = 1
    End If
    
    sPassword = EfilingCommon.getmsgstate
    ActiveSheet.Unprotect Password:=sPassword
    
   
    ReDim shts(1 To Worksheets.Application.ActiveWorkbook. _
        Windows(1).SelectedSheets.count)
    i = 0
    For Each sht In _
        Application.ActiveWorkbook.Windows(1).SelectedSheets
        Sheets(sht.name).Select
        
        i = i + 1
        shts(i) = sht.name
    
        x = Sheets(sht.name).UsedRange.Rows.count 'lastcell fixup
    
        Selection.Resize(rowsize:=2).Rows(2).EntireRow. _
        Resize(rowsize:=vRows).Insert Shift:=xlDown
    
        ActiveSheet.Unprotect Password:=sPassword
        Selection.AutoFill Selection.Resize( _
        rowsize:=vRows + 1), xlFillDefault
    
        On Error Resume Next
        
        ActiveSheet.Unprotect Password:=sPassword

        Selection.Offset(1).Resize(vRows).EntireRow.SpecialCells(xlConstants).ClearContents
    
    Next sht
    Worksheets(shts).Select
    InsertRowsAndFillFormulasOneRow = vRows

    ActiveSheet.Protect Password:=sPassword
End Function
