Function ScheduleSI() As Object
On Error Resume Next
Dim i As Long
Dim jsonDictionary, SplCodeRateTax1
Dim SplCodeRateTax

Set jsonDictionary = CreateObject("Scripting.Dictionary")
Set SplCodeRateTax1 = CreateObject("Scripting.Dictionary")

Set SplCodeRateTax = New Collection

    If Not IsEmpty(SecCode_SI1) And UBound(SecCode_SI1) > 0 Then
        
        For i = 1 To UBound(SecCode_SI1)
            
            Debug.Print SecCode_SI1(i)
            
        If SecCode_SI1(i) <> "" Then
        'Newly added by Bindu "5Eacg" & "5Eacg_BE" As per DE V4
            If Trim(SecCode_SI1(i)) <> "5BBF_BP" And Trim(SecCode_SI1(i)) <> "5BBG_BP" And Trim(SecCode_SI1(i)) <> "PTI_5BBC" And Trim(SecCode_SI1(i)) <> "5A1aiiaci" And Trim(SecCode_SI1(i)) <> "PTI_5A1aiiaci" And Trim(SecCode_SI1(i)) <> "5BBDA" And Trim(SecCode_SI1(i)) <> "PTI_5BBDA" And Trim(SecCode_SI1(i)) <> "PTI_5BB" And Trim(SecCode_SI1(i)) <> "PTI_5BBE" And Trim(SecCode_SI1(i)) <> "xx" And Trim(SecCode_SI1(i)) <> "FA" And Trim(SecCode_SI1(i)) <> "5BBF_XXXX" And Trim(SecCode_SI1(i)) <> "5BBG_XXXX" And Trim(SecCode_SI1(i)) <> "5BBC" And Trim(SecCode_SI1(i)) <> "5Eacg_BE" And Trim(SecCode_SI1(i)) <> "5Eacg" Then
                
                If Trim(SecCode_SI1(i)) <> "" Then
                    If Trim(SecCode_SI1(i)) = "5AC1a" Then
                        SecCode_SI1(i) = "5AC1ab"
                    End If
                    If Trim(SecCode_SI1(i)) = "PTI_5AC1a" Then
                        SecCode_SI1(i) = "PTI_5AC1ab"
