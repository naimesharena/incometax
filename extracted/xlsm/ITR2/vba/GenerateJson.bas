Function HMACSHA256A(strToSign As String, strKey() As Byte, ByVal iteration As Long)

    Dim lngLoop As Long
    Dim oUTF, oEnc
    Dim HMAC() As Byte
    Dim lastrow As Long
    Dim byteString() As Byte
     Dim byteS() As Byte
     Dim test As Variant 'Malli_AY_2025_26
     
    On Error GoTo err_handler
    Set test = New HS256
    test.InitHmac strKey
    byteString = StrConv(strToSign, vbFromUnicode)
'    byteString = Test.ToUTF8(strToSign)
    byteS = test.HmacSha256(byteString)
    Dim i, j As Variant
     For i = 1 To iteration
        test.InitHmac strKey
        byteString = ((byteS))
        byteS = test.HmacSha256(byteString)
    Next
    HMACSHA256A = EncodeBase64json(byteS)
'    Worksheets("Log Sheet").Cells(lastrow, 4) = "Pass"
    Exit Function

err_handler:
'    Worksheets("Log Sheet").Cells(lastrow, 4) = "Fail"
'    Worksheets("Log Sheet").Cells(lastrow, 5) = Err.Description
    MsgBox Err.Description, vbCritical

End Function

Public Function Base64_HMACSHA256_JSON(ByVal iteration As Long, sTextToHash As String, ByVal sSharedSecretKey As String)

    Dim asc As Object, enc As Object
    Dim TextToHash() As Byte
    Dim SharedSecretKey() As Byte
    
    Dim tempTextToHash() As Byte
    Dim tempString, CountTextToHash As Variant
    Dim i, j As Variant
    
    Set asc = CreateObject("System.Text.UTF8Encoding")
    Set enc = CreateObject("System.Security.Cryptography.HMACSHA256")
    ReDim TextToHash(0)
    subProcCaption = "Encrypting JSON"
    TextToHash = StrConv(sTextToHash, vbFromUnicode)
        UpdateProgressBar
    SharedSecretKey = asc.Getbytes_4(sSharedSecretKey)
    enc.Key = SharedSecretKey

    Dim byteS() As Byte
    byteS = enc.ComputeHash_2((TextToHash))
    
    For i = 1 To iteration
        byteS = enc.ComputeHash_2((byteS))
    Next
     
    Base64_HMACSHA256_JSON = EncodeBase64json(byteS)
    Set asc = Nothing
    Set enc = Nothing

End Function


Function EncodeBase64json(ByRef arrData() As Byte) As String

    Dim objXML As Object
    Dim objNode As Object

    Set objXML = CreateObject("MSXML2.DOMDocument")
    Set objNode = objXML.createElement("b64")

    objNode.DataType = "bin.base64"
    objNode.nodeTypedValue = arrData
    EncodeBase64json = objNode.text

    Set objNode = Nothing
    Set objXML = Nothing

End Function

